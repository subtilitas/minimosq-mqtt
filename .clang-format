---
BasedOnStyle: LLVM
Language: Cpp
Standard: c++17
IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
DerivePointerAlignment: false
AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
SpacesBeforeTrailingComments: 2
# LLVM's -2 combined with IndentWidth 4 would indent access specifiers
# by two columns; this repository writes them flush left.
AccessModifierOffset: -4
